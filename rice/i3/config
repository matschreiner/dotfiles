set $mod Mod4
# Test comment for diff preview
exec_always --no-startup-id bash -c "sleep 1 && setxkbmap us"

# Enable tap-to-click and natural (inverted) scrolling for touchpad
exec_always --no-startup-id xinput set-prop "SYNA8022:00 06CB:CE67 Touchpad" "libinput Tapping Enabled" 1
exec_always --no-startup-id xinput set-prop "SYNA8022:00 06CB:CE67 Touchpad" "libinput Natural Scrolling Enabled" 1
# exec_always --no-startup-id picom --experimental-backends
exec_always --no-startup-id picom --experimental-backends --backend glx --vsync
exec_always --no-startup-id $HOME/.config/polybar/launch_polybars.sh
exec_always --no-startup-id $HOME/dotfiles/scripts/battery-monitor.sh

# bindsym $mod+m exec --no-startup-id bash -c "$HOME/dotfiles/scripts/change_screen.sh"
bindsym $mod+m exec --no-startup-id bash -c "/home/masc/dotfiles/scripts/change_screen.sh >> /tmp/change_screen.log 2>&1"



# assign [class="Alacritty"] → 1
# assign [class="Google-chrome"] → 2
# assign [class="Slack"] → 3


bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +10%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 10%-

# Screenshot with flameshot
bindsym $mod+Print exec --no-startup-id flameshot full --path ~/screenshots --clipboard
bindsym Print exec --no-startup-id flameshot gui --path ~/screenshots --clipboard


# App launcher
bindsym $mod+r exec --no-startup-id /home/masc/dotfiles/rice/rofi/launcher.sh
# kill focused window
bindsym $mod+q kill
bindsym $mod+Shift+q exec --no-startup-id xkill
# Power menu
bindsym $mod+p exec /home/masc/dotfiles/rice/rofi/powermenu.sh
bindsym $mod+b exec /home/masc/dotfiles/rice/rofi/bluetooth.sh
bindsym $mod+z exec i3lock-fancy 


bindsym $mod+Shift+Right move workspace to output right
bindsym $mod+Shift+Left  move workspace to output left
bindsym $mod+Shift+Up    move workspace to output up
bindsym $mod+Shift+Down  move workspace to output down

bindsym $mod+Shift+f exec --no-startup-id bash -c 'i3-msg "border pixel 4; border_color #fabd2f", sleep 0.2, i3-msg "border pixel 2; border_color #3c3836"'

#arandr
bindsym $mod+a exec --no-startup-id arandr


# bindsym $mod+Shift+f exec --no-startup-id bash -c 'i3-msg "border pixel 4; border_color #fabd2f", sleep 0.2, i3-msg "border pixel 2; border_color #3c3836"'
# bindsym $mod+Shift+f exec --no-startup-id notify-send "Focused: $(i3-msg -t get_tree | jq -r ".. | select(.focused?) | .name")"
# toggle tiling / floating
# bindsym $mod+Shift+f floating toggle



# Font for window titles. Will also be used by the bar unless a different fon
# is used in the bar {} block below.
font pango:monospace 8

# This font is widely installed, provides lots of unicode glyphs, right-to-left
# text rendering and scalability on retina/hidpi displays (thanks to pango).
#font pango:DejaVu Sans Mono 8

# Start XDG autostart .desktop files using dex. See also
# https://wiki.archlinux.org/index.php/XDG_Autostart
exec --no-startup-id dex --autostart --environment i3

# The combination of xss-lock, nm-applet and pactl is a popular choice, so
# they are included here as an example. Modify as you see fit.

# xss-lock grabs a logind suspend inhibit lock and will use i3lock to lock the
# screen before suspend. Use loginctl lock-session to lock your screen.
# exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork

# NetworkManager is the most popular way to manage wireless networks on Linux,
# and nm-applet is a desktop environment-independent system tray GUI for it.
exec --no-startup-id nm-applet
exec --no-startup-id blueman-applet

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# move tiling windows via drag & drop by left-clicking into the title bar,
# or left-clicking anywhere into the window while holding the floating modifier.
tiling_drag modifier titlebar

bindsym $mod+Return exec alacritty



# A more modern dmenu replacement is rofi:
# bindcode $mod+40 exec "rofi -modi drun,run -show drun"
# There also is i3-dmenu-desktop which only displays applications shipping a
# .desktop file. It is a wrapper around dmenu, so you need that installed.
# bindcode $mod+40 exec --no-startup-id i3-dmenu-desktop

# change focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# split in vertical orientation
bindsym $mod+v split v

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+t layout toggle tabbed split

# focus the parent container
# bindsym $mod+a focus parent

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# don't go to last if already on the chosen workspace
workspace_auto_back_and_forth off

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Swap workspace number mode
# Press Mod+n, then a number to swap current workspace with that number
bindsym $mod+n mode "swap"
mode "swap" {
    bindsym 1 exec --no-startup-id /home/masc/dotfiles/rice/i3/swap-workspace.sh 1, mode "default"
    bindsym 2 exec --no-startup-id /home/masc/dotfiles/rice/i3/swap-workspace.sh 2, mode "default"
    bindsym 3 exec --no-startup-id /home/masc/dotfiles/rice/i3/swap-workspace.sh 3, mode "default"
    bindsym 4 exec --no-startup-id /home/masc/dotfiles/rice/i3/swap-workspace.sh 4, mode "default"
    bindsym 5 exec --no-startup-id /home/masc/dotfiles/rice/i3/swap-workspace.sh 5, mode "default"
    bindsym 6 exec --no-startup-id /home/masc/dotfiles/rice/i3/swap-workspace.sh 6, mode "default"
    bindsym 7 exec --no-startup-id /home/masc/dotfiles/rice/i3/swap-workspace.sh 7, mode "default"
    bindsym 8 exec --no-startup-id /home/masc/dotfiles/rice/i3/swap-workspace.sh 8, mode "default"
    bindsym 9 exec --no-startup-id /home/masc/dotfiles/rice/i3/swap-workspace.sh 9, mode "default"
    bindsym 0 exec --no-startup-id /home/masc/dotfiles/rice/i3/swap-workspace.sh 10, mode "default"
    bindsym Escape mode "default"
    bindsym Return mode "default"
}

# reload the configuration file
bindsym $mod+Shift+c reload
# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r restart

