[MAIN]
disable=
    missing-docstring,
    import-error,
    unspecified-encoding,
    too-few-public-methods,
    too-many-arguments,
    too-many-locals,
    too-many-instance-attributes,
    line-too-long,
    too-many-statements
    arguments-differ
    unused-variable,


good-names-rgxs=[_a-zA-Z][_a-zA-Z0-9]?$

msg-template={msg_id}({category}): {msg}

[FORMAT]
max-line-length=120



